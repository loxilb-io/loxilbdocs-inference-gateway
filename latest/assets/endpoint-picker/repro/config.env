#!/usr/bin/env bash
# ============================================================================
# Endpoint Picker verification + cache benchmark harness — configuration
# When the cluster or topology changes, this is the only file to edit.
# Pod IPs, the pod count and the EPP ClusterIP are discovered with kubectl at
# run time, so they are not listed here.
# ============================================================================

# --- how to invoke kubectl ---
# A plain kubeconfig: "kubectl". RKE2 control-plane node without KUBECONFIG exported:
#   KUBECTL="sudo -n /var/lib/rancher/rke2/bin/kubectl --kubeconfig /etc/rancher/rke2/rke2.yaml"
KUBECTL=${KUBECTL:-kubectl}

# --- namespace / resource names ---
NS=${NS:-llm-d-pd-disaggregation}                  # namespace of the vLLM pods and the EPP
POD_LABEL=${POD_LABEL:-llm-d.ai/role=aggregated}   # label selector of the model-server pods
TARGET_PORT=${TARGET_PORT:-8000}                   # the pods' serving port
EPP_DEPLOY=${EPP_DEPLOY:-pd-disaggregation-epp}    # EPP Deployment
EPP_SVC=${EPP_SVC:-pd-disaggregation-epp}          # EPP Service (ClusterIP is discovered)
EPP_GRPC_PORT=${EPP_GRPC_PORT:-9002}               # EPP ext_proc gRPC port
EPP_CONTAINER=${EPP_CONTAINER:-epp}                # EPP container name (for logs and the --v patch)
POOL_KIND=${POOL_KIND:-inferencepool}              # InferencePool CRD kind
POOL_NAME=${POOL_NAME:-pd-disaggregation}
POOL_DEFAULT_SELECTOR=${POOL_DEFAULT_SELECTOR:-'{"llm-d.ai/guide":"pd-disaggregation"}'}  # restored after a run

# --- gateway (loxilb-igw) ---
LOXILB_API=${LOXILB_API:-http://192.0.2.10:11111/netlox/v1}   # REST base URL
VIP=${VIP:-192.0.2.10}                             # externalIP of the test rule
PORT=${PORT:-8080}                                 # port of the test rule
LB_MODE=${LB_MODE:-4}                              # fullproxy
SEL_EPP=${SEL_EPP:-0}; SEL_CHWBL=${SEL_CHWBL:-8}; SEL_RR=${SEL_RR:-0}   # selector values
EPP_FAILMODE=${EPP_FAILMODE:-FailClose}; EPP_TIMEOUT_MS=${EPP_TIMEOUT_MS:-3000}
LOXILB_LOG_NS=${LOXILB_LOG_NS:-kube-system}; LOXILB_LOG_SEL=${LOXILB_LOG_SEL:-ds/loxilb-lb}
EPP_METRIC=${EPP_METRIC:-loxilb_ai_epp_requests_total}

# --- model / tokenizer ---
MODEL=${MODEL:-Qwen/Qwen3-32B-FP8}
TOKENIZER=${TOKENIZER:-$MODEL}   # guidellm tokenizer; must match the served model or the measured cache reuse is wrong

# --- EPP log levels (the verification steps need per-request lines) ---
EPP_V_DEBUG=${EPP_V_DEBUG:-4}; EPP_V_NORMAL=${EPP_V_NORMAL:-2}

# --- benchmark sizes ---
STREAMS=${STREAMS:-16}                             # default concurrency
SWEEP_STREAMS=${SWEEP_STREAMS:-1,4,8,16,32,64}     # concurrency levels of the sweep
SWEEP_DUR=${SWEEP_DUR:-40}                         # seconds per sweep level
TURNS_LONG=${TURNS_LONG:-15}; TURNS_SHORT=${TURNS_SHORT:-4}
PREFIX_LONG=${PREFIX_LONG:-2000}; PREFIX_SHORT=${PREFIX_SHORT:-120}
PROMPT_LONG=${PROMPT_LONG:-100}; PROMPT_SHORT=${PROMPT_SHORT:-60}
OUT_LONG=${OUT_LONG:-32}; OUT_SHORT=${OUT_SHORT:-16}
PREFIX_COUNT=${PREFIX_COUNT:-40}                   # distinct conversations (prefixes)
BENCH_DUR=${BENCH_DUR:-300}                        # seconds per mode in the multi-turn benchmark

# --- verification sizes ---
VERIFY_N=${VERIFY_N:-60}                           # requests in verify-path
GUIDELLM_BIN=${GUIDELLM_BIN:-$HOME/.local/bin/guidellm}

MODES=${MODES:-"epp chwbl rr"}
